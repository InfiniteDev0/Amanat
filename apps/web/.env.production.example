# production (amanat-prod). Real values live in the host's environment settings
# (Vercel), never in git. This file only lists the names.

# Public: safe in the browser. Row-level security decides what this key can do.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only, never NEXT_PUBLIC_: bypasses row-level security. Not used yet.
SUPABASE_SECRET_KEY=

# Sentry (errors): the project DSN, from Sentry → Project Settings → Client Keys.
# Public by design. Empty = Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
