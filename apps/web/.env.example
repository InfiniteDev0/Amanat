# Copy to .env.local for your machine (never committed). Values for local
# Supabase come from `pnpm exec supabase status` after `supabase start`.

# Public: safe in the browser. Row-level security decides what this key can do.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only, never NEXT_PUBLIC_: bypasses row-level security. Not used yet.
SUPABASE_SECRET_KEY=

# Sentry (errors): the project DSN, from Sentry → Project Settings → Client Keys.
# Public by design. Empty = Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
